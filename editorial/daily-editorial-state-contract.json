      "now": "2026-10-02T05:00:00+09:00",
      "evidence": {
        "BLOG-20260930-oxy02": {
          "publish_status": "PUBLISHED",
          "published_url": "https://therev-lab.com/blog/oxygen-room-how-to-spend-time/",
          "publish_verified_at": "2026-10-01T02:06:00.000Z"
        }
      },
      "expect": {
        "action": "CREATE_NEW",
        "creation_status": "READY_TO_CREATE",
        "candidate_id": "BT-20260930-FAC-01",
        "queue_status": "DRAFTING"
      }
    }
  ],
  "flow": [
    "EVERY_DAY_FIXED_TIME",
    "PREPARE_NEXT_DAY_ARTICLE",
    "DRAFT",
    "QC",
    "GBP",
    "IMAGES",
    "REVIEW_READY",
    "HUMAN_PUBLISH",
    "POST_PUBLISH_STATE_AUTO_SYNC"
  ],
  "post_publish_reconciliation": {
    "github": "content/blog/{slug}.md status: published (human Publish commit)",
    "production_deployment": "Deploy to Xserver success for the exact publish commit",
    "supabase": "publish_status PUBLISH_COMMITTED -> PUBLISHED (publish_verified_at, published_url)",
    "queue": "26_DAILY_EDITORIAL_QUEUE queue_status -> PUBLISHED",
    "bridge": "25_WEB_PUBLISH_BRIDGE bridge_status -> PUBLISHED + published_url",
    "gbp": "22_GBP_POST [BLOG_URL] -> production URL, BLOCKED_URL -> READY (never posted)",
    "post_history": "NOT_WRITTEN: 01_POST_HISTORY feeds the Instagram planner, embeddings and performance sync by post_id; Blog history lives in Queue + Bridge"
  }
}
