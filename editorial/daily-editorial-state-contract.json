{
  "schema_version": "1.5.0",
  "contract_id": "the-rev-daily-editorial-state-contract-v1",
  "source_of_truth": {
    "settings_sheet": "08_SETTINGS",
    "queue_sheet": "26_DAILY_EDITORIAL_QUEUE",
    "gbp_sheet": "22_GBP_POST",
    "automation_log_sheet": "18_AUTOMATION_LOG",
    "gas_supervisor_version": "v0.6.5.2",
    "bridge_sheet": "25_WEB_PUBLISH_BRIDGE",
    "decision_engine": "lib/dailyEditorialStateMachine.mjs",
    "decision_api": "POST /api/integrations/editorial-status {action:daily_plan}",
    "gas_gate_version": "v0.6.9",
    "gas_gate_source": "editorial/gas/DailyEditorialGate_v0.6.9.gs",
    "creator_source": "editorial/gas/DailyEditorialCreator_v0.6.9.gs",
    "creator_engine": "lib/dailyEditorialCreator.mjs",
    "knowledge_registry": "lib/dailyEditorialKnowledge.mjs"
  },
  "new_queue_no_interview": {
    "queue_status": "DRAFTING",
    "knowledge_gate": "SUFFICIENT",
    "interview_required": false,
    "interview_status": "NOT_REQUIRED",
    "draft_status": "NOT_STARTED",
    "image_status": "NOT_STARTED",
    "forbidden_draft_statuses": [
      "PENDING"
    ]
  },
  "daily_creation": {
    "editorial_runs": "EVERY_DAY (shop closed days included)",
    "run_date": "JST day the Editorial run happens",
    "target_date": "content / publish day = run_date + prepare_lead_days",
    "cadence_setting": "daily_editorial_cadence",
    "cadence_values": [
      "BUSINESS_DAYS",
      "DAILY"
    ],
    "cadence_default": "BUSINESS_DAYS",
    "cadence_applies_to": "TARGET_DATE",
    "lead_setting": "daily_editorial_lead_days",
    "idempotency_key": "target_date (legacy rows: run_date)",
    "prepare_lead_days": 1,
    "business_days": [
      "TU",
      "WE",
      "TH",
      "SA",
      "SU"
    ],
    "gate_hour_jst": 4,
    "creator_start_jst": "05:00",
    "watchdog_hour_jst": 8,
    "max_active_queue": 5,
    "max_new_topics_per_run": 1,
    "active_statuses_count_toward_cap": [
      "NEW",
      "KNOWLEDGE_CHECK",
      "INTERVIEW_WAITING",
      "INTERVIEW_COMPLETE",
      "DRAFTING",
      "QC",
      "IMAGE_PREPARING",
      "REVIEW_READY",
      "ERROR"
    ],
    "active_is_exclusive_lock": false,
    "review_ready_blocks_creation": false,
    "existing_work_is_parallel": true,
    "notification_failure_blocks_creation": false,
    "reconcile_before_active_count": true,
    "missed_creation_end_state": "ERROR_BLOCKED"
  },
  "daily_creator": {
    "executable": "editorial/gas/DailyEditorialCreator_v0.6.9.gs",
    "selection_engine": "lib/dailyEditorialCreator.mjs",
    "knowledge_registry": "lib/dailyEditorialKnowledge.mjs",
    "decision_api": "POST /api/integrations/editorial-status {action:daily_create}",
    "decision_authority": "GATE_ONLY",
    "external_operator_may_decide": false,
    "external_operator_allowed_role": "mechanical_fallback_only",
    "window_jst": "every day 05:00-11:59 hourly (start hour = daily_editorial_hour)",
    "idempotency_key": "target_date (legacy rows: run_date)",
    "candidate_source_sheet": "23_BLOG_TOPIC_SHORTLIST",
    "candidate_selection": "highest portfolio_final_score, then pillar_adjusted_score, then total_score; raw score gate applies first",
    "candidate_max_age_days": 14,
    "creates_queue_row": {
      "queue_status": "DRAFTING",
      "knowledge_gate": "SUFFICIENT",
      "interview_required": false,
      "interview_status": "NOT_REQUIRED",
      "draft_status": "NOT_STARTED",
      "image_status": "NOT_STARTED",
      "web_bridge_status": "NOT_SYNCED",
      "run_date": "RUN_DAY",
      "target_date": "RUN_DAY_PLUS_LEAD"
    },
    "success_requires": [
      "queue_row_read_back_from_sheet",
      "queue_status_DRAFTING",
      "shortlist_candidate_marked_SELECTED"
    ],
    "not_success": [
      "CREATE_NEW_recorded_only",
      "watchdog_failure_notice",
      "line_sent_without_queue_row"
    ],
    "fail_closed_when": [
      "supervisor_not_wired",
      "bridge_unavailable",
      "no_eligible_candidate",
      "only_interview_required_candidates",
      "queue_write_not_persisted"
    ],
    "downstream_owner": "scheduledDailyEditorialSupervisorV065 (GAS v0.6.5.2, 1-minute trigger)",
    "stuck_rules_minutes": {
      "supervisor_not_picking_up": 10,
      "stage_stalled": 30,
      "image_stalled_hours": 6
    },
    "knowledge_sufficiency": "registered first-party source required; unregistered lanes need Interview and are never auto-drafted",
    "review_ready_notification": "Supervisor announces while run_date is today; the Creator announces upcoming articles the Supervisor missed (shared de-dupe key)",
    "content_id_format": "BLOG-<target YYYYMMDD>-<6 hex>; the Bridge dates the article by this target day",
    "fallback": {
      "primary": "GAS Gate/Creator + Vercel Bridge + GitHub Actions",
      "secondary": "ChatGPT Scheduled Task as mechanical fallback only (DAILY_CREATOR_RUNBOOK.md section 5)",
      "fallback_may_decide": false,
      "shared_decision": "POST editorial-status {action:daily_create}",
      "duplicate_protection": "target_date idempotency in the Gate and under the GAS script lock"
    },
    "review_required_auto_recovery": {
      "scope": "STANDARD length gate only",
      "near_miss_max_deficit": "max(200 chars, 15% of minimum)",
      "max_retries": 2,
      "retry_transition": "REVIEW_REQUIRED -> PATCHING / NOT_STARTED -> existing Supervisor",
      "forbidden_auto_bypass": [
        "Fact Gate",
        "Topic Gate",
        "Editor safety review"
      ],
      "exhausted_state": "REVIEW_REQUIRED + notification"
    }
  },
  "publish_reconciliation": {
    "from_queue_statuses": "ANY_NON_TERMINAL",
    "to_queue_status": "PUBLISHED",
    "to_web_bridge_status": "PUBLISHED",
    "required_evidence": {
      "supabase_publish_status": "PUBLISHED",
      "publish_verified_at_required": true,
      "published_url_required": true,
      "supabase_promotion_requires": "exact_commit_deploy_xserver_success_and_live_url"
    },
    "insufficient_evidence": [
      "PUBLISH_COMMITTED",
      "GITHUB_COMMIT_ONLY",
      "QUEUE_STATUS",
      "HUMAN_MEMORY"
    ],
    "gbp_blog_url_placeholder_resolved": true,
    "gbp_auto_post": false
  },
  "handoffs": [
    {
      "name": "draft_to_image",
      "from_queue_status": "DRAFTING",
      "when": "draft_ready_and_image_job_created",
      "required_before_handoff": {
        "draft_status": "READY"
      },
      "to_queue_status": "IMAGE_PREPARING",
      "to_image_status": "PREPARING",
      "to_web_bridge_status": "IMAGE_PREPARING"
    },
    {
      "name": "image_to_review",
      "from_queue_status": "IMAGE_PREPARING",
      "when": "blog_gbp_row_thumbnail_ogp_gbp_ready_visual_qc_pass_and_xserver_verified",
      "required_before_handoff": {
        "draft_status": "READY",
        "gbp_post_row_exists": true,
        "gbp_parent_blog_id_matches": true,
        "image_status": "READY",
        "gbp_image_status": "READY"
      },
      "to_queue_status": "REVIEW_READY",
      "to_web_bridge_status": "PREVIEW_READY",
      "review_url_required": true
    }
  ],
  "completion": {
    "silent_stop_forbidden": true,
    "success_requires_notification_evidence": true,
    "intermediate_states_never_success": [
      "NEW",
      "KNOWLEDGE_CHECK",
      "DRAFTING",
      "QC",
      "IMAGE_PREPARING",
      "NOT_SYNCED"
    ],
    "allowed_end_states": [
      {
        "state": "REVIEW_READY",
        "notification_type": "REVIEW_READY",
        "notification_required": true
      },
      {
        "state": "INTERVIEW_WAITING",
        "notification_type": "INTERVIEW_QUESTIONS",
        "notification_required": true
      },
      {
        "state": "ERROR_BLOCKED",
        "notification_type": "ERROR_BLOCKED",
        "notification_required": true
      },
      {
        "state": "NO_ACTION",
        "notification_type": "NO_ACTION",
        "notification_required": true
      }
    ]
  },
  "resume": {
    "enabled": true,
    "stuck_timeout_minutes": 10,
    "required_fields_on_stop": [
      "last_successful_stage",
      "next_stage",
      "human_action_required"
    ]
  },
  "publish_boundary": {
    "auto_publish": false,
    "human_approval_required": true,
    "auto_publish_gate": "lib/editorialAutoPublishGate.mjs",
    "auto_publish_env": "AUTO_PUBLISH_ENABLED",
    "auto_publish_setting": "auto_publish",
    "both_keys_required": true,
    "executor_installed": false
  },
  "regression_scenarios": [
    {
      "name": "incident_2026_10_01_review_ready_one_of_five",
