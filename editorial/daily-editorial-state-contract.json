        "action": "NO_ACTION",
        "reason": "CLOSED_DAY"
      }
    },
    {
      "name": "creator_2026_10_03_review_ready_does_not_block_new_article",
      "kind": "creation",
      "fixture": "editorial/fixtures/daily-queue-2026-10-03-snapshot.json",
