# THE REV. Admin / Editorial Console — 環境変数テンプレート
# 実際の値はこのファイルには書かず、Vercelプロジェクトの
# Settings > Environment Variables に登録してください。
# （このファイル自体はダミー値のみで、コミットしても安全です）

# --- GitHub（記事Markdownのコミットに使用。Phase Dで使用開始） ---
# Fine-grained Personal Access Token。対象リポジトリのみ、Contents: Read and write 権限で発行する。
# この値はVercel Functionsの中だけで使用し、ブラウザ・/api/config・ログへは絶対に出力しない。
GITHUB_TOKEN=
# 例: maxi001maxi/the-rev-website
GITHUB_REPO=
# コミット対象ブランチ（通常 main）
GITHUB_BRANCH=main

# --- Publish権限（Phase D） ---
# 記事のPublish（GitHubへの書き込み）を許可するSupabase Authのuser.id（UUID）。
# 認証済みであるだけでは公開させないための追加ゲート。未設定の場合はPublish APIが常に403を返す。
# Supabase Dashboard → Authentication → Users → 対象ユーザーの「User UID」をコピーして設定する。
ADMIN_PUBLISHER_USER_ID=

# --- Supabase（Admin認証・Audit log等。Phase B以降） ---
SUPABASE_URL=
# Publishable key（旧anon key相当）。ブラウザに公開される前提の値で秘密情報ではない。
SUPABASE_PUBLISHABLE_KEY=
# secret key（旧service role key相当）。Phase B・C・Dのいずれでも使用しない。
# Adminの認可はSupabaseのRow Level Security（auth.uid() = user_id）で行うため、
# サーバー側でもこのキーは使わない方針。設定不要。
SUPABASE_SERVICE_ROLE_KEY=

# --- GA4 Data API（Dashboardの閲覧データ表示。Phase E以降） ---
GA4_PROPERTY_ID=
# service accountのJSON鍵ファイルの中身をそのまま1行で（base64推奨）
GA4_SERVICE_ACCOUNT_JSON=
