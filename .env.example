# THE REV. Admin / Editorial Console — 環境変数テンプレート
# 実際の値はこのファイルには書かず、Vercelプロジェクトの
# Settings > Environment Variables に登録してください。
# （このファイル自体はダミー値のみで、コミットしても安全です）

# --- GitHub（記事Markdown / 記事画像のコミットに使用） ---
# Fine-grained Personal Access Token。対象リポジトリのみ、Contents: Read and write 権限で発行する。
# この値はVercel Functionsの中だけで使用し、ブラウザ・/api/config・ログへは絶対に出力しない。
GITHUB_TOKEN=
# 例: maxi001maxi/the-rev-website
GITHUB_REPO=
# コミット対象ブランチ（通常 main）
GITHUB_BRANCH=main

# --- Publish権限（Phase D / Phase 9） ---
# Phase 9 Bridgeで新規Working Draftを作成する際の初期owner user.id（UUID）。
# Publish権限そのものは public.admin_members を正本として判定する。
ADMIN_PUBLISHER_USER_ID=

# --- Supabase（Admin認証・Working Draft） ---
SUPABASE_URL=
# Publishable key（旧anon key相当）。ブラウザに公開される前提の値で秘密情報ではない。
SUPABASE_PUBLISHABLE_KEY=
# secret/service-role key。Editorial Bridgeだけがサーバー側で使用する。
# Browserへは絶対に出さない。Vercel Environment Variablesにだけ登録する。
SUPABASE_SERVICE_ROLE_KEY=

# --- Editorial AI bridge ---
# GASとVercel Functionだけが共有する十分に長いランダム文字列。
# LINE token / OpenAI key / Supabase keyとは別の値を使用する。
EDITORIAL_BRIDGE_SECRET=

# --- Blog Image Automation（Phase 10） ---
# OPENAI_API_KEY は任意。未設定でも既存THE REV.実写を記事テーマから自動選定し、
# Thumbnail / OGPを自動準備するためPreview処理は停止しない。
# 設定すると conceptual_only（既定）では BODY KNOWLEDGE 系のみGPT Imageで
# 「実在施設の偽写真ではない」Editorial illustrationを生成する。
OPENAI_API_KEY=
# off / conceptual_only / all
EDITORIAL_IMAGE_AI_MODE=conceptual_only
# 2026-09時点の推奨既定。必要時のみ上書きする。
EDITORIAL_IMAGE_MODEL=gpt-image-2
# low / medium / high / auto
EDITORIAL_IMAGE_QUALITY=medium

# --- GA4 Data API（Dashboardの閲覧データ表示。Phase E以降） ---
GA4_PROPERTY_ID=
# service accountのJSON鍵ファイルの中身をそのまま1行で（base64推奨）
GA4_SERVICE_ACCOUNT_JSON=
