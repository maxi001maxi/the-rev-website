# THE REV. Admin / Editorial Console — 環境変数テンプレート
# 実際の値はこのファイルには書かず、Vercelプロジェクトの
# Settings > Environment Variables に登録してください。
# （このファイル自体はダミー値のみで、コミットしても安全です）

# --- GitHub（記事Markdown / 記事画像のコミットに使用） ---
# Fine-grained Personal Access Token。対象リポジトリのみ、Contents: Read and write 権限で発行する。
# この値はVercel Functionsの中だけで使用し、ブラウザ・/api/config・ログへは絶対に出力しない。
GITHUB_TOKEN=
# 例: maxi001maxi/the-rev-website
GITHUB_REPO=
# コミット対象ブランチ（通常 main）
GITHUB_BRANCH=main

# --- Publish権限（Phase D / Phase 9） ---
# Phase 9 Bridgeで新規Working Draftを作成する際の初期owner user.id（UUID）。
# Publish権限そのものは public.admin_members を正本として判定する。
ADMIN_PUBLISHER_USER_ID=

# --- Supabase（Admin認証・Working Draft） ---
SUPABASE_URL=
# Publishable key（旧anon key相当）。ブラウザに公開される前提の値で秘密情報ではない。
SUPABASE_PUBLISHABLE_KEY=
# secret/service-role key。Editorial Bridge / Google Business Profile等のサーバー側連携だけで使用する。
# Browserへは絶対に出さない。Vercel Environment Variablesにだけ登録する。
SUPABASE_SERVICE_ROLE_KEY=

# --- Editorial AI bridge ---
# GASとVercel Functionだけが共有する十分に長いランダム文字列。
# LINE token / OpenAI key / Supabase keyとは別の値を使用する。
EDITORIAL_BRIDGE_SECRET=

# --- Blog Image Automation（Phase 10 Reference V2） ---
# 旧5記事をStyle ReferencesとしてGPT Imageでデザインベースを生成し、
# Playwrightで正確な日本語コピーを合成する。
# GitHub Actions secretにも同名のOPENAI_API_KEYを登録する。
OPENAI_API_KEY=
EDITORIAL_IMAGE_MODEL=gpt-image-2
EDITORIAL_IMAGE_QUALITY=high
EDITORIAL_IMAGE_QA_MODEL=gpt-5.6-luna
# PRODUCTION_URL は未指定時 https://therev-lab.com を使用。
PRODUCTION_URL=https://therev-lab.com

# --- Legacy direct GA4 Data API helper (optional) ---
# Site Insights / Admin Analytics の通常表示には不要。
# 直接Google Data APIへ接続する旧経路を個別利用するときだけ設定する。
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# --- THE REV. Intelligence / Google Workspace (server-only, read-only) ---
# 専用service accountを推奨。未設定時は既存GA4_SERVICE_ACCOUNT_JSONを同じservice accountとして再利用する。
# Google Sheets API / Google Drive APIを有効化し、対象Sheet/Folderをclient_emailへ閲覧者共有する。
# tokenは spreadsheets.readonly / drive.readonly scopeだけで発行し、Browserへ返さない。
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON=
# 対象IDは未指定時にv0.1の監査済みIDを使用する。環境別に差し替える場合のみ設定する。
INTELLIGENCE_KPI_SPREADSHEET_ID=
INTELLIGENCE_EDITORIAL_SPREADSHEET_ID=
INTELLIGENCE_WEEKLY_REPORT_FOLDER_ID=
INTELLIGENCE_MARKETING_REPORT_FOLDER_ID=

# --- Site Insights v2 + Admin Analytics (server-only) ---
# GSC Wizard read-only MCP API key。GSC / GA4 / Blended / Analyticsで共通利用。
# GitHub/HTML/JS/API response/logに実値を書かない。
GSC_WIZARD_API_KEY=


# --- Google Business Profile (server-only OAuth) ---
# Google Auth Platform のWeb OAuth client。実値はVercelにのみ登録する。
GBP_GOOGLE_CLIENT_ID=
GBP_GOOGLE_CLIENT_SECRET=
GBP_GOOGLE_REDIRECT_URI=https://the-rev-website.vercel.app/api/admin/google-business/callback
