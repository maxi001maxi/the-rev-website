{
  "outputDirectory": "dist",
  "trailingSlash": true,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/admin/login/",
      "has": [
        {
          "type": "host",
          "value": "admin\\.therev-lab\\.com"
        }
      ],
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/integrations/editorial-status?mode=company_os_ga4_cron",
      "schedule": "10 22 * * *"
    },
    {
      "path": "/api/integrations/editorial-status?mode=company_os_gsc_cron",
      "schedule": "15 22 * * *"
    },
    {
      "path": "/api/integrations/editorial-status?mode=company_timeline_github_cron",
      "schedule": "20 20 * * *"
    }
  ]
}
