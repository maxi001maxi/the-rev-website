{
  "outputDirectory": "dist",
  "trailingSlash": true,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/api/admin/google-business/callback",
      "destination": "/api/admin/google-business?action=callback"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/admin/login/",
      "has": [
        {
          "type": "host",
          "value": "admin\\.therev-lab\\.com"
        }
      ],
      "permanent": false
    }
  ]
}
